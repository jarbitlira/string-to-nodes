{
  "name": "string-to-nodes",
  "version": "0.1.0",
  "description": "Framework-agnostic recursive string replacement: turn strings into arrays of React elements, Vue VNodes, DOM nodes or safe HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarbitlira/string-to-nodes.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/html.d.ts",
        "default": "./dist/html.js"
      },
      "require": {
        "types": "./dist/html.d.cts",
        "default": "./dist/html.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint:package",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@types/react": ">=17"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vue/server-renderer": "^3.5.43",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.43"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "1.5 kB"
    }
  ],
  "keywords": [
    "string",
    "replace",
    "react",
    "vue",
    "svelte",
    "dom",
    "regex",
    "linkify"
  ],
  "engines": {
    "node": ">=16"
  }
}
